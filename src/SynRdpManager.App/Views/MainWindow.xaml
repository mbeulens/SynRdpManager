<Window x:Class="SynRdpManager.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SynRdpManager.App.ViewModels"
        Title="SynRdpManager" Height="600" Width="760" MinHeight="300" MinWidth="460"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}">
    <Window.Resources>
        <!-- Explicit (empty) style for entry rows, so the group style's IsExpanded binding is not inherited. -->
        <Style x:Key="EntryItemStyle" TargetType="TreeViewItem" />
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4">
            <Button DockPanel.Dock="Right" Content="⚙" ToolTip="Settings" MinWidth="32" Margin="4,0,0,0"
                    Command="{Binding SettingsCommand}" />
            <Button DockPanel.Dock="Right" Content="Edit PuTTY template" Padding="8,2" Margin="4,0,0,0"
                    ToolTip="Open the PuTTY template session that new SSH sessions are copied from"
                    Command="{Binding EditTemplateCommand}" />
            <Button DockPanel.Dock="Right" Content="⟳ Refresh" Padding="8,2" Margin="8,0,0,0"
                    ToolTip="Reload the server list from 1Password"
                    Command="{Binding RefreshCommand}" />
            <Grid>
                <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" Padding="2,3"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Search…" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="Gray"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>

        <!-- Banner: latest message, dismissible -->
        <Border DockPanel.Dock="Top" Margin="8,4" Padding="8,6" BorderThickness="1" CornerRadius="2"
                Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#E5F1FB" />
                    <Setter Property="BorderBrush" Value="#9CC3E6" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BannerIsWarning}" Value="True">
                            <Setter Property="Background" Value="#FFF4CE" />
                            <Setter Property="BorderBrush" Value="#E0C36A" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" ToolTip="Dismiss" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0" Padding="6,0" Margin="8,0,0,0"
                        Command="{Binding DismissBannerCommand}" />
                <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" Foreground="Gray" />
                <TextBlock Text="●" Margin="0,0,6,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Gray" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                    <Setter Property="Foreground" Value="#2E9E44" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding StatusText}" />
            </DockPanel>
        </Border>

        <!-- Servers per vault -->
        <TreeView x:Name="ServerTree" Margin="8,4" ItemsSource="{Binding Groups}"
                  MouseDoubleClick="ServerTree_MouseDoubleClick" KeyDown="ServerTree_KeyDown">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type vm:GroupViewModel}" ItemsSource="{Binding Entries}"
                                          ItemContainerStyle="{StaticResource EntryItemStyle}">
                    <StackPanel Orientation="Horizontal" Background="Transparent" Margin="0,2">
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Reload all from template"
                                          Command="{Binding Owner.ReloadAllCommand}" CommandParameter="{Binding}" />
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CountText}" Foreground="Gray" Margin="6,0,0,0" />
                    </StackPanel>
                </HierarchicalDataTemplate>

                <DataTemplate DataType="{x:Type vm:EntryViewModel}">
                    <StackPanel Orientation="Horizontal" Background="Transparent" Margin="0,1">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAddress}" Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                        <Setter Property="ToolTip" Value="No hostname in 1Password" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <StackPanel.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Connect" FontWeight="Bold"
                                          Command="{Binding Owner.ConnectCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Copy hostname"
                                          Command="{Binding Owner.CopyHostnameCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Copy username"
                                          Command="{Binding Owner.CopyUsernameCommand}" CommandParameter="{Binding}" />
                                <Separator Visibility="{Binding IsSsh, Converter={StaticResource BoolToVis}}" />
                                <MenuItem Header="Reload from template"
                                          Visibility="{Binding IsSsh, Converter={StaticResource BoolToVis}}"
                                          Command="{Binding Owner.ReloadFromTemplateCommand}" CommandParameter="{Binding}" />
                                <MenuItem Header="Edit in PuTTY"
                                          Visibility="{Binding IsSsh, Converter={StaticResource BoolToVis}}"
                                          Command="{Binding Owner.EditInPuttyCommand}" CommandParameter="{Binding}" />
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <TextBlock Text="{Binding Icon}" Width="22" />
                        <TextBlock Text="{Binding Title}" MinWidth="240" Margin="0,0,16,0" />
                        <TextBlock Text="{Binding HostText}" Foreground="Gray" />
                    </StackPanel>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
    </DockPanel>
</Window>
